# Chat needs a model. Without one the app still boots and the Operations
# dashboard / policy engine / eval harness all work, but chat is disabled.
#
# Pick ONE provider block below.

# --- Option A: Groq free tier (key from console.groq.com) ---
PP_PROVIDER=openai_compat
PP_BASE_URL=https://api.groq.com/openai/v1
PP_API_KEY=gsk_...
PP_MODEL=openai/gpt-oss-120b
PP_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b   # tried when the main model hits its free-tier cap

# --- Option B: Gemini free tier (key from aistudio.google.com) ---
# PP_PROVIDER=openai_compat
# PP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# PP_API_KEY=your-gemini-key
# PP_MODEL=gemini-3.8-flash

# --- Option C: local Ollama (fully offline, no key) ---
# PP_PROVIDER=openai_compat
# PP_BASE_URL=http://localhost:11434/v1
# PP_MODEL=qwen2.5:14b

# --- Option D: Claude (paid API) ---
# PP_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# PP_MODEL=claude-opus-5
# PP_EFFORT=high               # low | medium | high | xhigh | max (Claude only)
# PP_REFUSAL_FALLBACK=true     # server-side fallback on a policy decline (Claude only)

# Optional overrides
PP_MAX_TOKENS=8000
PP_MAX_AGENT_STEPS=10
PP_HOST=0.0.0.0
PP_PORT=8000
