__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store

# Secrets — never commit. The template stays.
.env
.env.*
!.env.example

# Runtime state (mock action log). The built search index in data/index/ IS
# committed: serverless deploys can't write it at startup.
data/runtime/*.json

# Vercel project link
.vercel

# React build output (frontend/ -> `npm run build`); built fresh on every deploy.
/public/

# Playwright artefacts. Only the screenshots the README uses are committed.
frontend/test-results/
frontend/playwright-report/
docs/screenshots/*
!docs/screenshots/chat-desktop-1280.png
!docs/screenshots/chat-mobile-375.png
!docs/screenshots/ops-tablet-768.png
!docs/screenshots/login-mobile-375.png
