# Never upload secrets or the local virtualenv.
.env
.env.*
!.env.example
.venv/
venv/

# Not needed at runtime.
__pycache__/
*.py[cod]
.pytest_cache/
tests/
evals/
scripts/
data/runtime/
Dockerfile
.dockerignore
Procfile
render.yaml
*.md

# Frontend: Vercel installs and builds it fresh (vercel.json); never upload local
# dependencies, build output or browser-test artefacts.
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
public/
docs/
